<local:UI x:Class="NEAGUIs.SettingsUI"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:local="clr-namespace:NEAGUIs"
          Title="Settings"
          Height="500"
          Width="800"
          Background="{DynamicResource WindowBackground}">

    <Viewbox Stretch="Uniform">
        <Grid Width="800"
              Height="500"
              Background="{DynamicResource WindowBackground}"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ### LEFT CATEGORY PANEL -->
            <Border Background="{DynamicResource AccentColor}"
                    Padding="5"
                    Margin="0,0,10,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="CategoryList"
                             SelectionChanged="CategoryList_SelectionChanged"
                             BorderThickness="0"
                             FontSize="16"
                             Padding="5"
                             Background="Transparent"
                             Foreground="Black"/>
                </ScrollViewer>

            </Border>

            <!-- ### RIGHT SETTINGS PANEL -->
            <Border Grid.Column="1"
                    Background="{DynamicResource PrimaryColor}"
                    Padding="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel"
                                Margin="10"/>
                </ScrollViewer>

            </Border>

        </Grid>
    </Viewbox>

</local:UI>