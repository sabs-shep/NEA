<local:UI x:Class="NEAGUIs.ColourTestUI"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:local="clr-namespace:NEAGUIs"
          Title="Colour Test" Height="200" Width="400">

    <Viewbox Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
        <Viewbox.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.102"/>
                <TranslateTransform/>
            </TransformGroup>
        </Viewbox.RenderTransform>

        <Grid Width="400" Height="200" Background="{Binding BackgroundBrush}">

            <!-- Heading and instruction (accent colour from theme) -->
            <TextBlock Width="368"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       TextAlignment="Center">
                <Run Language="en-gb" Text="Colour Test"/>
                <LineBreak/>
                <Run Language="en-gb" Text="Please select the colour that's easiest to read on"/>
            </TextBlock>

            <!-- Buttons -->
            <Button Width="120" Height="79"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,47,0,0"
                    Background="{Binding Button1Background}"
                    Click="Button1_Click">
                <TextBlock Text="{Binding ReferenceText}" TextAlignment="Center"/>
            </Button>

            <Button Width="120" Height="79"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,47,0,0"
                    Background="{Binding Button2Background}"
                    Click="Button2_Click">
                <TextBlock Text="{Binding ReferenceText}" TextAlignment="Center"/>
            </Button>

            <Button Width="120" Height="79"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,47,10,0"
                    Background="{Binding Button3Background}"
                    Click="Button3_Click">
                <TextBlock Text="{Binding ReferenceText}" TextAlignment="Center"/>
            </Button>

            <!-- Finish button -->
            <Button x:Name="FinishButton" Width="88" Height="26"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    Click="Finish_Click">
                <TextBlock Text="Finish" TextAlignment="Center"/>
            </Button>

            <!-- Back button -->
            <Button x:Name="Back" Width="88" Height="26"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,302,10"
                    Click="Back_Click">
                <TextBlock Text="Back" TextAlignment="Center"/>
            </Button>

            <!-- Picture1: visible when hovering Finish OR Picture1 -->
            <Image x:Name="Picture1"
                   Margin="261,131,79,-10"
                   Source="pack://application:,,,/Picture1.png"
                   Stretch="Fill"
                   MouseLeftButtonUp="Finish_Click">
                <!-- ✅ ADDED -->
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=FinishButton, Path=IsMouseOver}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Picture1, Path=IsMouseOver}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Picture2: visible normally, hidden on hover Finish OR Picture1 -->
            <Image x:Name="Picture2"
                   Margin="168,131,183,7"
                   Source="pack://application:,,,/Picture2.png"
                   Stretch="Fill">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=FinishButton, Path=IsMouseOver}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Picture1, Path=IsMouseOver}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

        </Grid>
    </Viewbox>
</local:UI>