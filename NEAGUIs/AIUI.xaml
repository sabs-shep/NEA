<local:UI x:Class="NEAGUIs.AIChatUI"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:local="clr-namespace:NEAGUIs"
          Title="AI Chat"
          Height="600"
          Width="900"
          Background="{DynamicResource WindowBackground}">

	<local:UI.Resources>
		<DoubleAnimation x:Key="CollapseAnimation" To="40" Duration="0:0:0.25"/>
		<DoubleAnimation x:Key="ExpandAnimation" To="200" Duration="0:0:0.25"/>
		<DoubleAnimation x:Key="FadeOutAnimation" To="0.0" Duration="0:0:0.20"/>
		<DoubleAnimation x:Key="FadeInAnimation" To="1.0" Duration="0:0:0.20"/>
		<DoubleAnimation x:Key="RotateCollapseAnimation" To="90" Duration="0:0:0.25"/>
		<DoubleAnimation x:Key="RotateExpandAnimation" To="0" Duration="0:0:0.25"/>
	</local:UI.Resources>

	<Viewbox Stretch="Uniform">
		<Grid x:Name="MainGrid"
              Width="900"
              Height="600"
              Background="{DynamicResource WindowBackground}"
              Margin="10">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="40"/>
				<ColumnDefinition x:Name="LeftColumn" Width="200"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- COLLAPSE BUTTON -->
			<Button x:Name="CollapseButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="≡"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="5"
                    RenderTransformOrigin="0.5,0.5"
                    Click="CollapseButton_Click">
				<Button.RenderTransform>
					<RotateTransform x:Name="CollapseButtonRotate"/>
				</Button.RenderTransform>
			</Button>

			<!-- LEFT PANEL (CONVERSATIONS ONLY) -->
			<Border Grid.Row="0" Grid.Column="1"
                    Background="{DynamicResource AccentColor}"
                    Padding="5"
                    Margin="0,0,10,0"
                    x:Name="LeftPanel">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<!-- Conversations header -->
						<RowDefinition Height="*"/>
						<!-- Conversation list -->
						<RowDefinition Height="Auto"/>
						<!-- Conversation ID controls -->
						<RowDefinition Height="Auto"/>
						<!-- Select Context button -->
					</Grid.RowDefinitions>

					<!-- Conversations header -->
					<TextBlock Grid.Row="0"
                               Text="Conversations:"
                               FontWeight="Bold"
                               Margin="5"
                               Foreground="Black"/>

					<!-- Conversation list -->
					<ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,5,0,5">
						<StackPanel x:Name="ConversationList" Margin="5"/>
					</ScrollViewer>

					<!-- Conversation ID Controls -->
					<StackPanel Grid.Row="2" Margin="5" Orientation="Vertical">

						<TextBlock Text="Conversation ID:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"
                                   Foreground="Black"/>

						<TextBox x:Name="ConversationIdBox"
                                 Height="30"
                                 Padding="5"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="{DynamicResource AccentColor}"
                                 BorderThickness="1"
                                 TextAlignment="Left"
                                 VerticalContentAlignment="Center"/>

						<Button x:Name="ChangeConversationButton"
                                Content="Change Conversation"
                                Margin="0,5,0,10"
                                Background="{DynamicResource PrimaryColor}"
                                Foreground="Black"
                                Click="ChangeConversation_Click"/>
					</StackPanel>

					<!-- Select Context Button -->
					<Button x:Name="SelectContextButton"
                            Grid.Row="3"
                            Content="Select Context"
                            Margin="5"
                            Background="{DynamicResource PrimaryColor}"
                            Foreground="Black"
                            Click="SelectContext_Click"/>
				</Grid>
			</Border>

			<!-- CENTER CHAT PANEL -->
			<Border Grid.Row="0" Grid.Column="2"
                    Background="{DynamicResource PrimaryColor}"
                    Padding="10">

				<ScrollViewer x:Name="ConversationScrollViewer"
                              VerticalScrollBarVisibility="Auto">
					<StackPanel x:Name="ConversationPanel" Margin="10"/>
				</ScrollViewer>
			</Border>

			<!-- BOTTOM INPUT BAR -->
			<Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="40"/>
					<ColumnDefinition Width="40"/>
					<ColumnDefinition Width="40"/>
				</Grid.ColumnDefinitions>

				<TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Height="40"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextAlignment="Left"
                         FontSize="14"
                         Padding="10"
                         Background="White"
                         Foreground="Black"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource AccentColor}"
                         KeyDown="InputBox_KeyDown"/>

				<Button Grid.Column="1"
                        Content="🎤"
                        ToolTip="Speech-to-Text"
                        Click="Stt_Click"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"/>

				<Button Grid.Column="2"
                        Content="🌐"
                        ToolTip="Search Internet"
                        Click="Search_Click"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"/>

				<Button Grid.Column="3"
                        Content="📎"
                        ToolTip="Add File"
                        Click="AddFile_Click"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"/>
			</Grid>

		</Grid>
	</Viewbox>
</local:UI>