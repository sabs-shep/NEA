<local:UI x:Class="NEAGUIs.ToDoListUI"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:local="clr-namespace:NEAGUIs"
          Title="To-Do List"
          Height="200"
          Width="400"
          Background="{DynamicResource WindowBackground}">

    <Viewbox Stretch="Uniform">
        <!-- ### THEME BACKGROUND -->
        <!-- ## Match SettingsUI exactly -->
        <Grid Width="400" Height="200" Background="{DynamicResource WindowBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ### TOP TABS -->
            <StackPanel Orientation="Horizontal"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,10">
                <Button x:Name="UpcomingTab" Content="Upcoming" Width="110" Height="32" Margin="5" Click="UpcomingTab_Click"/>
                <Button x:Name="PastDueTab" Content="Past Due" Width="110" Height="32" Margin="5" Click="PastDueTab_Click"/>
                <Button x:Name="DoneTab" Content="Done" Width="110" Height="32" Margin="5" Click="DoneTab_Click"/>
            </StackPanel>

            <!-- ### SEARCH + SORT BAR -->
            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Margin="10,0,10,5">

                <!-- REMOVED: TextChanged="SearchBox_TextChanged" -->
                <TextBox x:Name="SearchBox"
                         Width="200"
                         Margin="0,0,10,0" />

                <ComboBox x:Name="SortBox"
                          Width="150"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="Title"/>
                    <ComboBoxItem Content="Priority"/>
                    <ComboBoxItem Content="Due Date"/>
                    <ComboBoxItem Content="Created"/>
                </ComboBox>
            </StackPanel>

            <!-- ### TASK LIST SCROLLVIEWER -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="10,0,45,0"
                          FlowDirection="RightToLeft">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="6"/>
                    </Style>
                </ScrollViewer.Resources>

                <ItemsControl x:Name="TaskList"
                              Width="365"
                              FlowDirection="LeftToRight">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Task_Click"
                                    Background="{DynamicResource AccentColor}"
                                    BorderThickness="0"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ### TITLE (LEFT) -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding title}"
                                               Foreground="Black"
                                               FontWeight="Bold"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0"/>

                                    <!-- ### DESCRIPTION (RIGHT) -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding description}"
                                               Foreground="Black"
                                               VerticalAlignment="Top"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>

                                    <!-- ### DUE DATE (BOTTOM RIGHT, DATE ONLY) -->
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding due_date, StringFormat='Due: {0:yyyy-MM-dd}'}"
                                               Foreground="Black"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ### ADD TASK BUTTON -->
            <Button x:Name="AddTaskButton"
                    Content="+"
                    Grid.Row="2"
                    Width="20" Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="370,10,0,0"
                    Background="{DynamicResource PrimaryColor}"
                    Foreground="Black"
                    Click="AddTaskButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <Viewbox Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextAlignment="Center"
                                           FontWeight="Bold"/>
                            </Viewbox>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ### ROBOT CANVAS -->
            <Canvas Grid.Row="3">
                <Image x:Name="RobotImage"
                       Width="32" Height="32"
                       Source="pack://application:,,,/Picture3.png"
                       Stretch="Uniform"/>
            </Canvas>

        </Grid>
    </Viewbox>
</local:UI>